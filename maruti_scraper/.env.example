# ── Database ──────────────────────────────────────────────────────────────────
# MySQL connection string (adjust host/port/user/password/db as needed)
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/maruti_parts

# ── API Security ──────────────────────────────────────────────────────────────
# Secret key to protect the API endpoints (pass in Authorization: Bearer <key>)
API_SECRET_KEY=change_this_to_a_secure_random_key

# ── Scraper Settings ──────────────────────────────────────────────────────────
# Delay between requests in seconds (be respectful - don't go below 1.0)
SCRAPE_DELAY_SECONDS=2.0

# Cache TTL in hours before re-scraping
CACHE_TTL_HOURS=24

# Playwright browser: chromium, firefox, webkit
PLAYWRIGHT_BROWSER=chromium

# ── App Settings ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
